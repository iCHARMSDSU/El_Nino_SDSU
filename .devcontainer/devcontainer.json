{
  "name": "El Niño Resource Library",
  "image": "mcr.microsoft.com/devcontainers/jekyll:2-bullseye",
  "postCreateCommand": "bundle install",
  "postAttachCommand": "bundle exec jekyll serve --baseurl '' --livereload --force_polling",
  "forwardPorts": [4000, 35729],
  "portsAttributes": {
    "4000": { "label": "Site preview", "onAutoForward": "openBrowser" },
    "35729": { "label": "Live reload", "onAutoForward": "silent" }
  }
}
